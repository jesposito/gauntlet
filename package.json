{
  "name": "gauntlet",
  "version": "0.0.1",
  "description": "Run a gauntlet of personas against your product. Get repro-ready UX + a11y bugs in 10 minutes.",
  "type": "module",
  "bin": {
    "gauntlet": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "bun run src/cli.ts run https://example.com --personas mary"
  },
  "keywords": ["playwright", "qa", "accessibility", "ux", "persona", "ai", "testing"],
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.50.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
